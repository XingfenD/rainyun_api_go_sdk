    "/product/ros/bucket/{id}/statistics": {
      "get": {
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "description": "存储桶ID",
            "in": "path",
            "name": "id",
            "required": true,
            "type": "integer"
          },
          {
            "in": "query",
            "name": "bucketId",
            "type": "integer"
          },
          {
            "description": "指定统计某一天的数据，指定该参数后，Duration 参数无效",
            "in": "query",
            "name": "date",
            "type": "string"
          },
          {
            "description": "使用过去多少小时的数据来统计",
            "enum": [
              1,
              3,
              6,
              12,
              24,
              72,
              168
            ],
            "in": "query",
            "name": "duration",
            "required": true,
            "type": "integer"
          },
          {
            "description": "限制返回多少个数据",
            "in": "query",
            "maximum": 100,
            "minimum": 1,
            "name": "limit",
            "required": true,
            "type": "integer"
          },
          {
            "description": "数据类别",
            "enum": [
              "file",
              "file_bytes",
              "client_ip",
              "referrer",
              "user_agent"
